"ai.guide.security_body" = "Do not share keys publicly. NotchMove stores saved credentials in macOS Keychain.";
"ai.guide.dashscope.overview" = "DashScope uses an Alibaba Cloud Model Studio API Key for the default transcription and parser flow.";
"ai.guide.dashscope.steps" = "1. Open the Alibaba Cloud Model Studio docs or API Key console and sign in.\n2. Enable Model Studio first if the page asks you to.\n3. On the API Key page, create an API KEY and copy it.\n4. Return to NotchMove, paste it into the DashScope API Key field, and save.\n5. Use Test transcriber or Test parser to confirm the setup.";
"ai.guide.openai.overview" = "OpenAI uses a project API Key for transcription and schedule parsing.";
"ai.guide.openai.steps" = "1. Open OpenAI Platform and sign in.\n2. Go to API Keys and create a new secret key.\n3. Copy the generated API Key. It is shown in full only once.\n4. Return to NotchMove, paste it into the OpenAI API Key field, and save.\n5. Use Test transcriber or Test parser to confirm the setup.";
"ai.guide.deepseek.overview" = "DeepSeek uses an OpenAI-compatible API for schedule parsing.";
"ai.guide.deepseek.steps" = "1. Open the DeepSeek API docs or platform console and sign in.\n2. Create or open the API Keys page.\n3. Create an API Key and copy it.\n4. Return to NotchMove, paste it into the DeepSeek API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.zhipu.overview" = "Zhipu GLM uses a Zhipu AI Open Platform API Key for schedule parsing.";
"ai.guide.zhipu.steps" = "1. Open the Zhipu AI docs or Open Platform console and sign in.\n2. Create or copy an API Key from the API Key page.\n3. Confirm the key can call GLM models.\n4. Return to NotchMove, paste it into the Zhipu GLM API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.minimax.overview" = "MiniMax uses an Open Platform API Key for schedule parsing.";
"ai.guide.minimax.steps" = "1. Open the MiniMax Open Platform docs or console and sign in.\n2. Go to the API Keys page.\n3. Create a new API Key or copy an existing usable key.\n4. Return to NotchMove, paste it into the MiniMax API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.moonshot.overview" = "Moonshot Kimi uses a Kimi Open Platform API Key for schedule parsing.";
"ai.guide.moonshot.steps" = "1. Open the Kimi/Moonshot Open Platform and sign in.\n2. Go to API Keys in the console.\n3. Create an API Key and copy it.\n4. Return to NotchMove, paste it into the Moonshot Kimi API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.tencent_hunyuan.overview" = "Tencent Hunyuan uses a Tencent Hunyuan API Key for schedule parsing.";
"ai.guide.tencent_hunyuan.steps" = "1. Open the Tencent Hunyuan API Key documentation and sign in to Tencent Cloud.\n2. Enable the Hunyuan API service if needed.\n3. Create an API Key on the console API Key page and copy it.\n4. Return to NotchMove, paste it into the Tencent Hunyuan API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.baidu_ernie.overview" = "Baidu Qianfan uses a Baidu Qianfan API Key for schedule parsing.";
"ai.guide.baidu_ernie.steps" = "1. Open the Baidu Qianfan API KEY docs or console and sign in.\n2. Go to API Key management under system management or security authentication.\n3. Create an API Key and make sure it has Baidu Qianfan model service permission.\n4. Return to NotchMove, paste it into the Baidu Qianfan API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.openrouter.overview" = "OpenRouter uses one API Key to access many models for schedule parsing.";
"ai.guide.openrouter.steps" = "1. Open the OpenRouter API Keys docs or settings page and sign in.\n2. Create a new API Key and optionally set a credit limit.\n3. Copy the generated API Key.\n4. Return to NotchMove, paste it into the OpenRouter API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.groq.overview" = "Groq uses a GroqCloud API Key with an OpenAI-compatible Base URL for schedule parsing.";
"ai.guide.groq.steps" = "1. Open Groq Console and sign in.\n2. Go to API Keys and create a key.\n3. Copy the generated API Key.\n4. Return to NotchMove, paste it into the Groq API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.xai.overview" = "xAI uses an xAI Console API Key for schedule parsing.";
"ai.guide.xai.steps" = "1. Open the xAI docs or xAI Console and sign in.\n2. Create an API Key on the API Keys page and confirm the account has credits.\n3. Copy the generated API Key.\n4. Return to NotchMove, paste it into the xAI API Key field, and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.custom_openai_compatible.overview" = "Custom OpenAI-Compatible works with any service that supports /chat/completions.";
"ai.guide.custom_openai_compatible.steps" = "1. Open your provider's docs and confirm it supports OpenAI-compatible Chat Completions.\n2. Find the Base URL, model name, and API Key.\n3. Return to NotchMove and fill Custom Base URL and Parser model.\n4. Paste the API Key into the Custom OpenAI-Compatible API Key field and save.\n5. Use Test parser to confirm the setup.";
"ai.guide.tencent_cloud_asr.overview" = "Tencent Cloud ASR uses Tencent Cloud Secret ID and Secret Key to sign speech recognition requests.";
"ai.guide.tencent_cloud_asr.steps" = "1. Open the Tencent Cloud ASR quick-start docs and sign in to Tencent Cloud.\n2. Enable the speech recognition service.\n3. Open CAM API key management, then create or copy a SecretId and SecretKey.\n4. Return to NotchMove, paste them into the Tencent Cloud ASR Secret ID and Secret Key fields, and save.\n5. Use Test transcriber to confirm the setup.";
"ai.guide.baidu_speech.overview" = "Baidu Speech uses the API Key and Secret Key from a Baidu Speech application.";
"ai.guide.baidu_speech.steps" = "1. Open the Baidu short speech recognition docs or Speech console and sign in.\n2. Create a Speech application and enable Short Speech Recognition or the fast edition.\n3. Copy the API Key and Secret Key from the application details.\n4. Return to NotchMove, paste them into the Baidu Speech API Key and Secret Key fields, and save.\n5. Use Test transcriber to confirm the setup.";
"ai.guide.iflytek.overview" = "iFlyTek uses App ID, API Key, and API Secret from a Voice Dictation application.";
"ai.guide.iflytek.steps" = "1. Open the iFlyTek Voice Dictation docs or console and sign in.\n2. Create a WebAPI app and add the streaming Voice Dictation service.\n3. Copy AppID, APIKey, and APISecret from the service authentication area.\n4. Return to NotchMove, paste them into the iFlyTek App ID, API Key, and API Secret fields, and save.\n5. Use Test transcriber to confirm the setup.";
"ai.guide.volcengine.overview" = "Volcengine ASR uses the App Key from Doubao Speech large-model recognition; older consoles may also require Access Key.";
"ai.guide.volcengine.steps" = "1. Open the Volcengine large-model recording recognition docs and sign in to the console.\n2. Enable the matching speech recognition capability in Doubao Speech.\n3. Copy appKey; if your console also provides accessKey, copy that too.\n4. Return to NotchMove, put appKey in Volcengine ASR API Key and accessKey in Access Key, then save.\n5. Use Test transcriber to confirm the setup.";
"ai.guide.apple_speech.overview" = "Apple Speech uses macOS Speech Recognition permission and does not need an API key.";
"ai.guide.apple_speech.steps" = "1. Choose Apple Speech as the transcription provider.\n2. Click Request Access if Speech Recognition has not been requested yet.\n3. Allow NotchMove in macOS Settings if permission was previously denied.\n4. Keep a parser provider selected because Apple Speech only creates transcript text.\n5. Use Test transcriber to confirm permission and language setup.";
